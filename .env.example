# Local development only.
#
# In production nothing reads this file: the GitHub Actions workflows pass these values
# in as environment variables, drawn from repository Secrets and Variables. See
# docs/ARCHITECTURE.md §15 for which is which.
#
# Never commit a real .env — it is git-ignored, and it must stay that way.

# ---------------------------------------------------------------------------
# Slack  (SLACK_BOT_TOKEN is a GitHub SECRET; SLACK_CHANNEL_ID is a VARIABLE)
# ---------------------------------------------------------------------------
# Bot token (xoxb-...) from the Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=xoxb-replace-me
# The single channel that receives summaries AND live-state notifications.
SLACK_CHANNEL_ID=C0000000000

# ---------------------------------------------------------------------------
# State API — the Cloudflare Worker
#   INTERNAL_API_SECRET is a GitHub SECRET; STATE_API_URL is a VARIABLE
# ---------------------------------------------------------------------------
# Base URL of the deployed Worker, printed by `wrangler deploy`. No trailing slash.
STATE_API_URL=https://ttv-calendar-bot.example.workers.dev
# The same value set on the Worker with `wrangler secret put INTERNAL_API_SECRET`.
# Generate one with:  openssl rand -hex 32
INTERNAL_API_SECRET=replace-with-at-least-32-characters-of-random

# ---------------------------------------------------------------------------
# Time  (GitHub VARIABLES)
# ---------------------------------------------------------------------------
# IANA zone used for every user-facing time and for scheduling. Never an offset.
APP_TIMEZONE=Europe/London
# The local hour the daily/weekly/monthly reports belong to.
SUMMARY_HOUR=8

# ---------------------------------------------------------------------------
# Tennis TV  (GitHub VARIABLES; all optional, all defaulted)
# ---------------------------------------------------------------------------
# Public site, used for deep links in Slack messages.
TENNISTV_BASE_URL=https://www.tennistv.com
# JSON API host used by the Tennis TV front end (see docs/TENNISTV_DATA_SOURCE.md).
TENNISTV_API_BASE_URL=https://api.tennistv.com
# Value sent as the `account-id` request header.
TENNISTV_ACCOUNT_ID=35
# live | fixture. `fixture` replays recorded responses from test/fixtures/tennistv,
# which is how the commands can be run locally without touching the real site.
TENNISTV_PROVIDER=live

# ---------------------------------------------------------------------------
# Behaviour  (GitHub VARIABLES; all optional, all defaulted)
# ---------------------------------------------------------------------------
# How much later a republished start must be before it is treated as a delay.
MONITOR_SCHEDULE_SLIP_MINUTES=15
# How long finished match state and settled notifications are kept in D1.
STATE_RETENTION_DAYS=30
# A whole-run ceiling enforced by the command, well inside the workflow's own timeout.
RUN_TIMEOUT_SECONDS=240

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# When true, Slack sends are logged and skipped instead of delivered. Also exposed as
# the `dry_run` input on both workflows' manual trigger.
SLACK_DRY_RUN=false
