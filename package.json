{
  "name": "ttv-calendar-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Slack bot that tells the QA team when Tennis TV has live tennis available for testing.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bot:monitor": "node --experimental-strip-types src/commands/monitor.ts",
    "bot:morning": "node --experimental-strip-types src/commands/morning.ts",
    "bot:simulate": "node --experimental-strip-types src/commands/simulate.ts",
    "bot:monitor:local": "node --env-file=.env --experimental-strip-types src/commands/monitor.ts",
    "bot:morning:local": "node --env-file=.env --experimental-strip-types src/commands/morning.ts",
    "bot:simulate:local": "node --env-file=.env --experimental-strip-types src/commands/simulate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.int.test.ts' --exclude '**/upstream-contract.test.ts'",
    "test:watch": "vitest",
    "test:contract": "TENNISTV_CONTRACT=live vitest run test/tennistv/upstream-contract.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "recon": "node --no-warnings --experimental-strip-types scripts/recon/run.ts",
    "recon:semantics": "node --no-warnings --experimental-strip-types scripts/recon/analyse-semantics.ts",
    "preview:messages": "node --no-warnings --experimental-strip-types scripts/preview-messages.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:build": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "worker:tail": "wrangler tail",
    "worker:types": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply ttv-calendar --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ttv-calendar --remote"
  },
  "dependencies": {
    "@slack/web-api": "^7.9.0",
    "luxon": "^3.7.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.131.2",
    "yaml": "^2.9.1"
  }
}
